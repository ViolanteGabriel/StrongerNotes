{
  "name": "strongernotes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:front && npm run test:back",
    "test:front": "npm test --prefix front -- --runInBand",
    "test:back": "npm test --prefix back",
    "test:e2e": "bash e2e/scripts/run-playwright.sh",
    "test:e2e:smoke": "bash e2e/scripts/run-playwright.sh --grep @smoke",
    "test:e2e:ui": "bash e2e/scripts/run-playwright.sh --ui",
    "test:e2e:debug": "bash e2e/scripts/run-playwright.sh --debug",
    "test:e2e:report": "playwright show-report",
    "e2e:db:up": "docker compose -f e2e/docker-compose.yml up -d",
    "e2e:db:reset": "bash e2e/scripts/prepare-db.sh",
    "e2e:db:down": "docker compose -f e2e/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0"
  }
}
